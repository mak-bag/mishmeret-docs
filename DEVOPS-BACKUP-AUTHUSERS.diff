           retention-days: 90
           if-no-files-found: error
 
+      # עותק מחוץ ל-GitHub. ארטיפקט ב-GitHub נופל יחד עם חשבון GitHub —
+      # זה מה שמגן מפני השתלטות על החשבון, ולא מפני מחיקה בלבד.
+      # מדלג בשקט כל עוד R2 לא הופעל (N9), ואינו מפיל את הגיבוי בגללו.
+      # **רץ לפני התרגיל**, מאותו נימוק שהקדים את הארטיפקט: תרגיל אדום לא
+      # אמור למנוע את העותק שמחוץ ל-GitHub — והוא דווקא זה שמגן מפני
+      # השתלטות על החשבון, להבדיל ממחיקה. (DevOps, 01/10)
+      - name: Copy to Cloudflare R2
+        env:
+          AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
+          AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
+          AWS_DEFAULT_REGION: auto
+          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
+        run: |
+          set -euo pipefail
+          if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${R2_ACCOUNT_ID:-}" ]; then
+            echo "R2 secrets absent - skipping off-provider copy (see N9)."
+            echo "R2_STATE=skipped" >> "$GITHUB_ENV"
+            exit 0
+          fi
+          aws s3 cp "mishmeret-$STAMP.pgc.gpg" \
+            "s3://mishmeret-backups/mishmeret-$STAMP.pgc.gpg" \
+            --endpoint-url "https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com" \
+            --only-show-errors
+          echo "R2_STATE=uploaded" >> "$GITHUB_ENV"
+
